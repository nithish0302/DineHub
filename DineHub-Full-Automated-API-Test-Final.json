{
  "info": {
    "_postman_id": "d615e026-3979-42f5-8320-1b527cad9655",
    "name": "DineHub - Full Automated API Test - Final",
    "description": "Final end-to-end automated test for User Service, JWT, Payment Service, logout and negative JWT cases. Food Service and Order Service are not required.",
