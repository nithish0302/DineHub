  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 - Create Test User') {",
          "    const stamp = Date.now();",
          "    pm.collectionVariables.set('userEmail', `dinehub.test.${stamp}@example.com`);",
          "    pm.collectionVariables.unset('userId');",
          "    pm.collectionVariables.unset('accessToken');",
          "    pm.collectionVariables.unset('refreshToken');",
          "    pm.collectionVariables.unset('paymentId');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Create Test User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/createUser",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "createUser"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"userEmail\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"userPhoneNumber\": \"{{userPhoneNumber}}\",\n  \"userAddress\": \"DineHub Test Address\",\n  \"userRole\": \"user\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create user returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('userId', String(body.userId));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ],
          "query": [
            {
              "key": "email",
              "value": "{{userEmail}}"
            },
            {
              "key": "password",
              "value": "{{userPassword}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', body.accessToken);",
              "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "    pm.collectionVariables.set('userId', String(body.userId));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Refresh Access Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "refresh"
          ],
          "query": [
            {
              "key": "refreshToken",
              "value": "{{refreshToken}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refresh returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    const token = pm.response.text().trim();",
              "    pm.test('New access token is returned', function () {",
              "        pm.expect(token).to.not.be.empty;",
              "    });",
              "    pm.collectionVariables.set('accessToken', token);",
              "}"
            ]
          }
        }
      ]
    },
