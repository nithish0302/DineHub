        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"DineHub Updated Test User\",\n  \"userPhoneNumber\": \"{{userPhoneNumber}}\",\n  \"userAddress\": \"DineHub Updated Address\",\n  \"userRole\": \"user\"\n}",
          "options": {
            "raw": {
              "language": "json"
