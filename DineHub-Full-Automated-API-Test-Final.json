        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"orderId\": {{orderId}},\n  \"amount\": 499.00,\n  \"paymentMethod\": \"upi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create payment returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Payment ID is returned', function () {",
              "    pm.expect(body.paymentId).to.exist;",
              "});",
              "pm.test('Payment status defaults to pending', function () {",
              "    pm.expect(body.paymentStatus).to.eql('pending');",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('paymentId', String(body.paymentId));",
              "}"
            ]
          }
        }
      ]
    },
