          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update user returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Updated name is correct', function () {",
              "    pm.expect(body.userName).to.eql('DineHub Updated Test User');",
              "});",
              "pm.test('Updated address is correct', function () {",
              "    pm.expect(body.userAddress).to.eql('DineHub Updated Address');",
              "});",
              "pm.test('Email is preserved', function () {",
              "    pm.expect(body.userEmail).to.eql(pm.variables.get('userEmail'));",
              "});"
